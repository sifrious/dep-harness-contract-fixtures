#!/usr/bin/env php
<?php

declare(strict_types=1);

use Opis\JsonSchema\Errors\ErrorFormatter;
use Opis\JsonSchema\Validator;
use Sifrious\HarnessContractFixtures\Fixture;

require dirname(__DIR__).'/vendor/autoload.php';

$root = dirname(__DIR__);
$fixtureJson = file_get_contents($root.'/fixtures/conversation-to-answer-v1.json');
$schemaJson = file_get_contents($root.'/schemas/conversation-to-answer-v1.schema.json');

if ($fixtureJson === false || $schemaJson === false) {
    throw new RuntimeException('Fixture or schema could not be read.');
}

$fixtureObject = json_decode($fixtureJson, false, 512, JSON_THROW_ON_ERROR);
$schemaObject = json_decode($schemaJson, false, 512, JSON_THROW_ON_ERROR);
$result = (new Validator)->validate($fixtureObject, $schemaObject);

if (! $result->isValid()) {
    $errors = (new ErrorFormatter)->format($result->error());
    throw new RuntimeException(json_encode($errors, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));
}

$fixture = Fixture::load();
$events = collectById($fixture['source']['conversation']['events']);
$candidates = collectById($fixture['expected']['aleph']['candidates'], 'candidate_id');
$accepted = collectById($fixture['expected']['funes']['records'], 'accepted_reference');
$passages = collectById($fixture['expected']['menard']['passages'], 'passage_reference');

foreach ($events as $event) {
    $canonicalPayload = json_encode($event['raw_payload'], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR);
    requireSame(hash('sha256', $canonicalPayload), $event['raw_payload_hash'], "raw payload hash for {$event['id']}");
}

requireSame(count($events), count($candidates), 'event and Aleph candidate counts');

foreach ($candidates as $candidate) {
    requirePresent($events, $candidate['raw_event_id'], 'Aleph raw event');
    requireSame($events[$candidate['raw_event_id']]['raw_payload_hash'], $candidate['raw_input_hash'], "Aleph lineage hash for {$candidate['candidate_id']}");
}

foreach ($accepted as $record) {
    requirePresent($candidates, $record['candidate_id'], 'Funes candidate');
    requireSame($candidates[$record['candidate_id']]['raw_input_hash'], $record['payload_hash'], "Funes payload hash for {$record['accepted_reference']}");
}

foreach ($passages as $passage) {
    foreach ($passage['accepted_references'] as $reference) {
        requirePresent($accepted, $reference, 'Menard accepted reference');
    }
}

foreach ($fixture['expected']['kilgore']['assertions'] as $assertion) {
    if ($assertion['citations'] === []) {
        throw new RuntimeException("Kilgore assertion [{$assertion['assertion_id']}] has no citations.");
    }

    foreach ($assertion['citations'] as $citation) {
        requirePresent($accepted, $citation['accepted_reference'], 'Kilgore accepted reference');
        requirePresent($passages, $citation['passage_reference'], 'Kilgore passage reference');
    }
}

$missingFact = $fixture['source']['question']['deliberately_absent_fact'];
requireSame([$missingFact], $fixture['expected']['kilgore']['completeness']['missing_facts'], 'Kilgore missing facts');
requireSame('unknown', $fixture['expected']['kilgore']['uncertainty'][$missingFact], 'Kilgore absent-fact uncertainty');

$encodedFixture = json_encode($fixture, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);

if (preg_match('/(\/Users\/|\/home\/|gh[pousr]_[A-Za-z0-9_]{20,}|sk-(?:proj-)?[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,})/', $encodedFixture) === 1) {
    throw new RuntimeException('Fixture contains a private path or credential-shaped value.');
}

requireSame($fixture, Fixture::load(), 'deterministic fixture load');

fwrite(STDOUT, "conversation-to-answer-v1 verified\n");

$lifecycle = Fixture::load('request-lifecycle-v1');
$steps = collectById($lifecycle['plan']['steps']);
requireSame([], $steps['step_discuss']['materialized_execution_request_ids'], 'discussion-only materialization');
requireSame(['request_01'], $steps['step_implement']['materialized_execution_request_ids'], 'execution materialization');
requireSame($lifecycle['user_input']['id'], $lifecycle['intent']['source_input_id'], 'immutable input lineage');
requireSame(
    'auth should work globally and the app should know whether any machines have ever been connected',
    $lifecycle['user_input']['exact_text'],
    'immutable canonical source text',
);
$inputReference = $lifecycle['user_input']['reference'];
requireSame('sifrious.cross-package-reference', $inputReference['contract'], 'portable reference contract');
requireSame(1, $inputReference['contract_version'], 'portable reference version');
requireSame('message_01', $inputReference['provenance']['id'], 'nested provenance reference');
requireSame($inputReference, json_decode(json_encode($inputReference, JSON_THROW_ON_ERROR), true, flags: JSON_THROW_ON_ERROR), 'portable reference JSON round trip');
requireSame('intent_01_v2', $lifecycle['intent']['superseded_by'], 'intent supersession');
$authorization = $lifecycle['authorization'];
requireSame('sifrious.authorization-context', $authorization['contract'], 'portable authorization contract');
requireSame('account_a', $authorization['actor']['actor']['id'], 'actor identity');
requireSame('tenant_a', $authorization['tenant']['tenant']['id'], 'tenant identity');
requireSame($authorization, json_decode(json_encode($authorization, JSON_THROW_ON_ERROR), true, flags: JSON_THROW_ON_ERROR), 'authorization JSON queue round trip');
$authorizationJson = strtolower(json_encode($authorization, JSON_THROW_ON_ERROR));
foreach (['token', 'password', 'secret', 'credential', 'session'] as $forbidden) {
    if (str_contains($authorizationJson, $forbidden)) {
        throw new RuntimeException("Authorization fixture contains forbidden credential-shaped field [{$forbidden}].");
    }
}
$executionContext = $lifecycle['preflight']['execution_context_reference'];
requireSame('stacks.execution-context-reference.v1', $executionContext['schema'], 'Stacks execution context schema');
requireSame($executionContext['head'], $lifecycle['preflight']['starting_revision'], 'execution context starting revision');
requireSame('execution_context_01', $executionContext['context_id'], 'stable execution context identity');
foreach ($lifecycle['stage_1_negative_cases'] as $negativeCase) {
    requireSame(0, $negativeCase['expected_provider_call_count'], "{$negativeCase['id']} provider call count");
}
requireSame('failed', $lifecycle['failed_verification_result']['required_verification'], 'failed verification outcome');
requireSame('failed', $lifecycle['failed_verification_result']['canonical_status'], 'failed verification canonical status');
requireSame(1, $lifecycle['failed_verification_result']['expected_finalization_count'], 'terminal finalization count');
$twinkle = $lifecycle['twinkle_variants']['with_twinkle'];
requireSame(false, $twinkle['execution_authorized'], 'Twinkle acceptance execution authority');
requireSame(['plan_01', 'workkit_01'], array_column($twinkle['promotion']['work_references'], 'id'), 'one-to-many Twinkle promotion');
requireSame([], $lifecycle['twinkle_variants']['unmaterialized_proposal']['observed_result_references'], 'unmaterialized proposal evidence');
requireSame(true, $lifecycle['twinkle_variants']['without_twinkle']['origin_lineage_preserved'], 'no-Twinkle lineage');
$multiWorkKit = $lifecycle['multi_work_kit_variant'];
requireSame(count($multiWorkKit['work_kit_ids']), $multiWorkKit['distinct_origin_relation_count'], 'multi-work-kit origin relations');
requireSame(1, $lifecycle['funes_replay']['historical_effect_count'], 'Funes idempotent replay effect count');
requireSame('input_01', $lifecycle['sha_traversal']['recovered_origin'], 'SHA traversal origin');
$origin = $lifecycle['execution_request']['origin'];
requireSame(
    ['input_01', 'intent_01_v2', 'conversation_01', 'twinkle_01', 'plan_01', 'workkit_01', 'step_implement'],
    [$origin['user_input'], $origin['intent'], $origin['conversation'], $origin['twinkle'], $origin['plan'], $origin['work_kit'], $origin['plan_step']],
    'execution request deliberation origin',
);
$relations = [];
foreach ($lifecycle['historical_relations'] as $relation) {
    $relations[$relation['subject'].'|'.$relation['predicate'].'|'.$relation['object']] = true;
}
foreach ([
    'input_01|started|conversation_01',
    'conversation_01|proposed|twinkle_01',
    'twinkle_01|promoted_to|plan_01',
    'conversation_01|produced|plan_01',
    'plan_01|contains|step_implement',
    'step_implement|materialized_as|request_01',
    'request_01|produced|run_01',
    'run_01|produced|commit_01',
    'commit_01|verified_by|test_run_01',
] as $requiredRelation) {
    requirePresent($relations, $requiredRelation, 'request lifecycle relation');
}
if ($lifecycle['run_result']['provider_claim'] === $lifecycle['run_result']['observed_outcome']) {
    throw new RuntimeException('Provider claim and observed outcome must remain distinct fields.');
}
fwrite(STDOUT, "request-lifecycle-v1 verified\n");

function collectById(array $items, string $key = 'id'): array
{
    $indexed = [];

    foreach ($items as $item) {
        $indexed[$item[$key]] = $item;
    }

    return $indexed;
}

function requirePresent(array $items, string $key, string $label): void
{
    if (! array_key_exists($key, $items)) {
        throw new RuntimeException("{$label} [{$key}] does not exist.");
    }
}

function requireSame(mixed $expected, mixed $actual, string $label): void
{
    if ($expected !== $actual) {
        throw new RuntimeException("{$label} does not match.");
    }
}
